    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@accountability/knowledge-verification": "git+https://github.com/neophilism/Knowledge-and-verification-engine.git#85e7185e608b4663254284b673256d17cf5da6e8"
  }
}
